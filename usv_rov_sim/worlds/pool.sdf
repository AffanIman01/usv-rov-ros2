<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <!--Calm-water prototype. Water surface z=0; floor z=-2m. The model owns SurfaceBuoyancy; do not also add the built-in world Buoyancy system.-->
  <world name="usv_pool">
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>.65 .65 .65</ambient_light>
        <background_color>.12 .18 .23</background_color>
        <camera_pose>5 -5 4 0 .45 2.35619449</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="View Control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity Context Menu">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">230</property>
          <property key="height" type="double">72</property>
          <property key="state" type="string">floating</property>
          <property key="z" type="double">1</property>
          <anchors target="3D View">
            <line own="left" target="left" />
            <line own="bottom" target="bottom" />
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">280</property>
          <property key="height" type="double">110</property>
          <property key="state" type="string">floating</property>
          <property key="z" type="double">1</property>
          <anchors target="3D View">
            <line own="right" target="right" />
            <line own="bottom" target="bottom" />
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
      </plugin>
    </gui>
    <gravity>0 0 -9.81</gravity>
    <physics name="pool_physics" type="ignored">
      <max_step_size>.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <scene>
      <ambient>.65 .65 .65 1</ambient>
      <background>.12 .18 .23 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>.9 .9 .9 1</diffuse>
      <specular>.1 .1 .1 1</specular>
      <direction>-.4 .2 -.9</direction>
    </light>
    <model name="pool_structure">
      <static>true</static>
      <link name="pool">
        <collision name="floor_collision">
          <pose>0 0 -2.1 0 0 0</pose>
          <geometry>
            <box>
              <size>20.6 12.6 .2</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -2.1 0 0 0</pose>
          <geometry>
            <box>
              <size>20.6 12.6 .2</size>
            </box>
          </geometry>
          <material>
            <ambient>.46 .57 .61 1</ambient>
            <diffuse>.46 .57 .61 1</diffuse>
          </material>
        </visual>
        <collision name="north_collision">
          <pose>0 6.15 -.8 0 0 0</pose>
          <geometry>
            <box>
              <size>20.6 .3 2.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 6.15 -.8 0 0 0</pose>
          <geometry>
            <box>
              <size>20.6 .3 2.4</size>
            </box>
          </geometry>
          <material>
            <ambient>.72 .76 .77 1</ambient>
            <diffuse>.72 .76 .77 1</diffuse>
          </material>
        </visual>
        <collision name="south_collision">
          <pose>0 -6.15 -.8 0 0 0</pose>
          <geometry>
            <box>
              <size>20.6 .3 2.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="south_visual">
          <pose>0 -6.15 -.8 0 0 0</pose>
          <geometry>
            <box>
              <size>20.6 .3 2.4</size>
            </box>
          </geometry>
          <material>
            <ambient>.72 .76 .77 1</ambient>
            <diffuse>.72 .76 .77 1</diffuse>
          </material>
        </visual>
        <collision name="east_collision">
          <pose>10.15 0 -.8 0 0 0</pose>
          <geometry>
            <box>
              <size>.3 12 2.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="east_visual">
          <pose>10.15 0 -.8 0 0 0</pose>
          <geometry>
            <box>
              <size>.3 12 2.4</size>
            </box>
          </geometry>
          <material>
            <ambient>.72 .76 .77 1</ambient>
            <diffuse>.72 .76 .77 1</diffuse>
          </material>
        </visual>
        <collision name="west_collision">
          <pose>-10.15 0 -.8 0 0 0</pose>
          <geometry>
            <box>
              <size>.3 12 2.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="west_visual">
          <pose>-10.15 0 -.8 0 0 0</pose>
          <geometry>
            <box>
              <size>.3 12 2.4</size>
            </box>
          </geometry>
          <material>
            <ambient>.72 .76 .77 1</ambient>
            <diffuse>.72 .76 .77 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="water_surface">
      <static>true</static>
      <link name="surface">
        <visual name="water">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 12</size>
            </plane>
          </geometry>
          <transparency>.45</transparency>
          <cast_shadows>false</cast_shadows>
          <material>
            <ambient>.03 .32 .44 1</ambient>
            <diffuse>.03 .42 .57 1</diffuse>
            <specular>.1 .1 .1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://me120_dynamic</uri>
      <name>me120</name>
      <pose>0 0 0.152784564 0 0 0</pose>
    </include>
  </world>
</sdf>